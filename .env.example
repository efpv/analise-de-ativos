# Configuração do pipeline de mercado (valores de exemplo, sem segredos).

# Projeto e banco Firestore. Sem projeto explícito, usa o projeto do ADC.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=(default)

# Prefixo das coleções (MARKET_ tem precedência sobre o legado FIRESTORE_PREFIX).
MARKET_FIRESTORE_PREFIX=
FIRESTORE_PREFIX=

# Universo de tickers. Prioridade: catálogo > arquivo > CSV.
MARKET_TICKERS=ITUB4,BBAS3,WEGE3,VALE3
MARKET_TICKERS_FROM_CATALOG=false
MARKET_CATALOG_PATH=data/ativos_b3.json
MARKET_TICKERS_FILE=

# Janelas e paralelismo.
MARKET_YEARS=5
MARKET_INCREMENTAL_DAYS=60
MARKET_MAX_RANGE_DAYS=3650
MARKET_WORKERS=2

# Fontes opcionais.
MARKET_B3_COTAHIST_DIR=
MARKET_B3_EVENTS_URL=

# Lotes e retry.
MARKET_BATCH_SIZE=500
MARKET_MAX_RETRIES=3
MARKET_RETRY_BACKOFF=1.0

# Reservado para a v2; não é usado na v1.
MARKET_ADMIN_TOKEN=
